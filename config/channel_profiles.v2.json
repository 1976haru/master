{
  "schemaVersion": "3.5.0",
  "description": "Analysis-driven safe defaults. Processing amounts are ceilings, not mandatory boosts or cuts.",
  "global": {
    "workingSampleRateHz": 48000,
    "outputBitDepth": 24,
    "neverOverwriteOriginal": true,
    "twoPassLoudness": true,
    "autoLatencyCompensation": true,
    "latencyDetectionMaxMs": 100,
    "tailPaddingMs": 500,
    "tailTrimThresholdDbfs": -75.0,
    "tailSafetyMs": 100,
    "truePeakOversampleFactor": 4,
    "bassMonoBelowHz": 110,
    "analysisMetrics": [
      "lufs_i",
      "lufs_s",
      "lra",
      "sample_peak_dbfs",
      "true_peak_dbtp",
      "crest_factor_db",
      "dc_offset",
      "clipped_sample_count",
      "band_energy_db",
      "spectral_centroid_hz",
      "stereo_correlation",
      "side_to_mid_db",
      "leading_silence_ms",
      "trailing_signal_ms",
      "processing_delay_samples"
    ],
    "qualityGate": {
      "lufsToleranceLu": 0.20,
      "truePeakToleranceDb": 0.05,
      "maximumClippedSamples": 0,
      "maximumResidualDelaySamples": 1,
      "maximumDcOffset": 0.0001,
      "minimumFullBandStereoCorrelation": -0.05,
      "minimumLowBandStereoCorrelation": 0.70,
      "rejectOnUnexpectedDurationLoss": true,
      "rejectOnTailCut": true,
      "rejectOnNaNOrInfinity": true
    },
    "autoFinish": {
      "enabled": true,
      "maximumAutoRerenders": 2,
      "minimumFinalLraLu": 3.5,
      "maximumCrestFactorLossDb": 0.75,
      "transparentFallbackEnabled": true,
      "transparentHighpassHz": 10,
      "tailWindowMs": 100,
      "tailEndRmsThresholdDbfs": -50.0,
      "tailLastSampleThresholdDbfs": -60.0,
      "energeticTailThresholdDbfs": -35.0,
      "energeticTailFadeMs": 400.0,
      "energeticTailFadeCandidatesMs": [400.0, 600.0, 800.0, 1200.0],
      "energeticTailTargetMarginDb": 0.5,
      "energeticTailMaximumFadeMs": 1200.0,
      "hardCutAutoFadeMs": 25.0,
      "microFadeMs": 5.0,
      "microFadeLastSampleThresholdDbfs": -80.0,
      "codecPreviewEnabled": true,
      "codecTruePeakSafetyMarginDb": 0.05,
      "codecCeilingStepDb": 0.20,
      "codecMaximumAutoGainPasses": 3,
      "codecPostGainSafetyMarginDb": 0.10,
      "codecMinimumGainStepDb": 0.05,
      "codecMaximumSingleGainReductionDb": 1.50,
      "codecMaximumTotalGainReductionDb": 2.00,
      "keepCodecPreviewAudio": false,
      "delayInformationLimitSamples": 8,
      "delayWarningLimitSamples": 47,
      "delayAutomaticAlignmentMinimumSamples": 48,
      "delayMaximumAutomaticAlignmentSamples": 4800,
      "delayMinimumConfidence": 0.70,
      "delayWindowCount": 5,
      "delayWindowSeconds": 6.0,
      "delayConsistencyToleranceSamples": 3,
      "genreLraReductionLimitLu": {
        "OLD POP": 0.60,
        "BALLAD": 0.80,
        "JAZZ": 0.50,
        "R&B": 0.90,
        "SOUL": 0.80,
        "CHANSON": 0.50,
        "CHILI EN": 0.80,
        "CHILI JP": 0.80,
        "SHOWA JP": 0.50
      }
    }
  },
  "profiles": {
